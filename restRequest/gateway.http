### get-customer-orders
< scripts/traceparent.js
GET http://localhost:{{application-port}}/api/v1/customers/{{customerId}}/orders
Accept: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=kbe-brewery-gateway

### create-order
< scripts/traceparent.js
POST http://localhost:{{application-port}}/api/v1/customers/{{customerId}}/orders
Content-Type: application/json
Accept: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=kbe-brewery-gateway

{
  "customerRef": "gateway-test",
  "beerOrderLines": [
    {
      "beerId": "{{beerId}}",
      "orderQuantity": 2
    }
  ]
}

> {%
    if (response.body.id) {
        client.environment.set("orderId", response.body.id);
    }
%}

### get-order-by-id
< scripts/traceparent.js
GET http://localhost:{{application-port}}/api/v1/customers/{{customerId}}/orders/{{orderId}}
